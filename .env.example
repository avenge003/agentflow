# API配置
APP_NAME=RagFlow API
APP_VERSION=1.1.0
DEBUG=false

# Milvus配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
# G7: 默认集合改为 policy_documents（与历史数据集合一致）
MILVUS_COLLECTION_NAME=policy_documents
# G7: 灰度切流 alias
MILVUS_COLLECTION_ALIAS=default
# G7: 启用 v2 schema（subject 纯字符串 + file_path 独立字段）
ENABLE_V2_SCHEMA=true

# 模型配置
EMBEDDING_MODEL_PATH=./models/embedding/bge-large-zh-v1.5
RERANKER_MODEL_PATH=./models/reranker/bge-reranker-large
EMBEDDING_DIMENSION=1024
USE_FP16=true

# API Key认证配置（支持逗号分隔多个Key）
API_KEYS=your-api-key-here

# 检索配置
DEFAULT_TOP_K=10
DEFAULT_SCORE_THRESHOLD=0.0
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5

# G1: 混合检索（Milvus Hybrid Search + RRF）参数
ENABLE_HYBRID=true
HYBRID_DENSE_LIMIT=20
HYBRID_SPARSE_LIMIT=20
RRF_K=60
